import FreeProbability.Algebraic.FreenessGroupingWords
import Mathlib.LinearAlgebra.Multilinear.Curry
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Group.Submonoid.Membership

/-! # Multilinear extension from generators to all grouped algebras -/

noncomputable section
open scoped Classical
namespace FreeProbability

/-- A multilinear map zero on every tuple of generators is zero on the tuple
of their coordinatewise spans. All finite orders, including zero, are covered. -/
theorem multilinear_eq_zero_on_spans {R M V : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M] [AddCommMonoid V] [Module R V] {n : ℕ}
    (F : MultilinearMap R (fun _ : Fin n => M) V) (s : Fin n → Set M)
    (hgen : ∀ x, (∀ i, x i ∈ s i) → F x = 0)
    (x : Fin n → M) (hx : ∀ i, x i ∈ Submodule.span R (s i)) : F x = 0 := by
  induction n with
  | zero => exact hgen x (fun i => i.elim0)
  | succ n ih =>
    have hhead (a : M) (ha : a ∈ s 0) : (F.curryLeft a) (Fin.tail x) = 0 := by
      apply ih (F.curryLeft a) (fun i => s i.succ)
      · intro y hy
        rw [MultilinearMap.curryLeft_apply]
        apply hgen
        intro i
        exact Fin.cases ha hy i
      · exact fun i => hx i.succ
    have hres : (F.curryLeft (x 0)) (Fin.tail x) = 0 := by
      refine Submodule.span_induction hhead ?_ ?_ ?_ (hx 0)
      · simp only [map_zero, _root_.zero_apply]
      · intro a b _ _ ha hb
        simp only [map_add, _root_.add_apply, ha, hb, add_zero]
      · intro c a _ ha
        simp only [map_smul, _root_.smul_apply, ha, smul_zero]
    simpa only [MultilinearMap.curryLeft_apply, Fin.cons_self_tail] using hres

variable {𝕜 A I J : Type*} [Field 𝕜] [Ring A] [Algebra 𝕜 A]

/-- Original letters assigned to one arbitrary grouped label. -/
def groupedGeneratorSet (B : I → Subalgebra 𝕜 A) (g : I → J) (j : J) : Set A :=
  {a | ∃ i, g i = j ∧ a ∈ B i}

/-- The entire algebra generated by all original subalgebras with this label. -/
def groupedSubalgebra (B : I → Subalgebra 𝕜 A) (g : I → J) (j : J) : Subalgebra 𝕜 A :=
  Algebra.adjoin 𝕜 (groupedGeneratorSet B g j)

/-- The multilinear cumulant agrees with the cumulant of its literal tuple word. -/
theorem cumulantMultilinear_ofFn (φ : ProbabilitySpace 𝕜 A) {n : ℕ} (x : Fin n → A) :
    cumulantMultilinear φ n x = cumulant φ (List.ofFn x) := by
  have h := cumulantMultilinear_eq φ (List.ofFn x)
  rw [apply_ofFn_get (fun n y => cumulantMultilinear φ n y) x] at h
  exact h

/-- ALL elements of the grouped generated algebras have vanishing mixed
cumulants, by generator words and multilinearity, with no topological premise. -/
theorem FreelyIndependent.cumulant_ofFn_eq_zero_of_grouped_mixed
    {φ : ProbabilitySpace 𝕜 A} {B : I → Subalgebra 𝕜 A} (hf : FreelyIndependent φ B)
    (g : I → J) {n : ℕ} (x : Fin n → A) (label : Fin n → J)
    (hmem : ∀ i, x i ∈ groupedSubalgebra B g (label i))
    (hmixed : ∃ i j, label i ≠ label j) : cumulant φ (List.ofFn x) = 0 := by
  rw [← cumulantMultilinear_ofFn]
  apply multilinear_eq_zero_on_spans (cumulantMultilinear φ n)
    (fun i => (Submonoid.closure (groupedGeneratorSet B g (label i)) : Set A))
  · intro y hy
    have hw (i : Fin n) := Submonoid.exists_list_of_mem_closure (hy i)
    let w := fun i => Classical.choose (hw i)
    have hletters : ∀ i a, a ∈ w i → ∃ j, g j = label i ∧ a ∈ B j := by
      intro i a ha
      exact (Classical.choose_spec (hw i)).1 a ha
    have hprod : (fun i => (w i).prod) = y := by
      funext i
      exact (Classical.choose_spec (hw i)).2
    rw [cumulantMultilinear_ofFn]
    rw [← hprod]
    exact hf.cumulant_wordProducts_eq_zero_of_grouped_mixed g label w hletters hmixed
  · intro i
    rw [← Algebra.adjoin_eq_span]
    exact hmem i

/-- Arbitrarily grouping a free family preserves freeness of the entire
algebras generated by each group. No finiteness, countability, trace, positivity,
or injectivity hypothesis on the grouping function is required. -/
theorem FreelyIndependent.groupedSubalgebra
    {φ : ProbabilitySpace 𝕜 A} {B : I → Subalgebra 𝕜 A} (hf : FreelyIndependent φ B)
    (g : I → J) : FreelyIndependent φ (groupedSubalgebra B g) := by
  apply (freelyIndependent_iff_mixedCumulantsVanish φ _).mpr
  intro w hmem hmix
  obtain ⟨a, ha, b, hb, hab⟩ := hmix
  obtain ⟨i, hi⟩ := List.get_of_mem ha
  obtain ⟨j, hj⟩ := List.get_of_mem hb
  have h := hf.cumulant_ofFn_eq_zero_of_grouped_mixed g
    (fun i => (w.get i).2) (fun i => (w.get i).1)
    (fun i => hmem _ (List.get_mem _ _))
    ⟨i, j, by simpa only [hi, hj] using hab⟩
  rw [List.ofFn_comp' w.get Prod.snd, List.ofFn_get] at h
  rw [labeledCumulant_eq]
  exact h
end FreeProbability
