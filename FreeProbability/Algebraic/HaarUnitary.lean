import FreeProbability.Algebraic.Invariance
import FreeProbability.Algebraic.Freeness
import Mathlib.Algebra.Star.Subalgebra

/-! # Haar unitaries through actual integer powers and star moments -/

namespace FreeProbability
variable {𝕜 A : Type*} [Field 𝕜] [Ring A] [StarRing A] [Algebra 𝕜 A]

/-- Integer powers are taken in the genuine unitary group, so the ambient
algebra need not have a division or integer-power operation. -/
def unitaryPower (u : unitary A) (j : ℤ) : A := (u ^ j : unitary A)

@[simp] theorem unitaryPower_zero (u : unitary A) : unitaryPower u 0 = 1 := by
  simp [unitaryPower]

@[simp] theorem unitaryPower_one (u : unitary A) : unitaryPower u 1 = (u : A) := by
  simp [unitaryPower]

theorem unitaryPower_add (u : unitary A) (j k : ℤ) :
    unitaryPower u (j + k) = unitaryPower u j * unitaryPower u k := by
  simp only [unitaryPower, zpow_add, Submonoid.coe_mul]

@[simp] theorem unitaryPower_neg (u : unitary A) (j : ℤ) :
    unitaryPower u (-j) = star (unitaryPower u j) := by
  simp only [unitaryPower, zpow_neg, ← Unitary.star_eq_inv, Unitary.coe_star]

/-- A Haar unitary has vanishing moments for every nonzero integer power. -/
def IsHaarUnitary (φ : ProbabilitySpace 𝕜 A) (u : unitary A) : Prop :=
  ∀ j : ℤ, j ≠ 0 → φ.expectation (unitaryPower u j) = 0

namespace IsHaarUnitary
variable {φ : ProbabilitySpace 𝕜 A} {u : unitary A}

/-- This includes the normalized zeroth moment, not just the nonzero powers. -/
theorem expectation_power (h : IsHaarUnitary φ u) (j : ℤ) :
    φ.expectation (unitaryPower u j) = if j = 0 then 1 else 0 := by
  by_cases hj : j = 0
  · simp [hj]
  · simp only [hj, ite_false]
    exact h j hj
end IsHaarUnitary

/-- A Boolean records whether a letter is the unitary or its adjoint. -/
def unitaryStarLetter (u : unitary A) (b : Bool) : A :=
  if b then star (u : A) else (u : A)

/-- The signed exponent of a complete star word. -/
def unitaryStarWordExponent (w : List Bool) : ℤ :=
  (w.map (fun b => if b then (-1 : ℤ) else 1)).sum

theorem unitaryStarLetter_eq_power (u : unitary A) (b : Bool) :
    unitaryStarLetter u b = unitaryPower u (if b then -1 else 1) := by
  cases b <;> simp [unitaryStarLetter]

/-- Every actual star word reduces to its signed unitary-group power. -/
theorem unitaryStarWord_product (u : unitary A) (w : List Bool) :
    (w.map (unitaryStarLetter u)).prod = unitaryPower u (unitaryStarWordExponent w) := by
  induction w with
  | nil => simp [unitaryStarWordExponent]
  | cons b w ih =>
    simp only [List.map_cons, List.prod_cons, unitaryStarWordExponent, List.sum_cons]
    rw [ih, unitaryStarLetter_eq_power, unitaryPower_add]
    rfl

/-- The complete Haar star-moment law follows from integer-power moments. -/
theorem IsHaarUnitary.expectation_starWord {φ : ProbabilitySpace 𝕜 A} {u : unitary A}
    (h : IsHaarUnitary φ u) (w : List Bool) :
    φ.expectation (w.map (unitaryStarLetter u)).prod =
      if unitaryStarWordExponent w = 0 then 1 else 0 := by
  rw [unitaryStarWord_product]
  exact h.expectation_power _

section GeneratedAlgebra
variable [StarRing 𝕜] [StarModule 𝕜 A]

/-- The entire unital star algebra generated by the actual unitary. -/
def haarUnitaryAlgebra (u : unitary A) : Subalgebra 𝕜 A :=
  (StarAlgebra.adjoin 𝕜 ({(u : A)} : Set A)).toSubalgebra

/-- Every positive or negative group power belongs to the entire generated
star algebra; no ambient inverse closure is being assumed. -/
theorem unitaryPower_mem_haarUnitaryAlgebra (u : unitary A) (j : ℤ) :
    unitaryPower u j ∈ haarUnitaryAlgebra (𝕜 := 𝕜) u := by
  cases j with
  | ofNat n =>
    change ((u ^ (n : ℤ) : unitary A) : A) ∈ haarUnitaryAlgebra (𝕜 := 𝕜) u
    rw [zpow_natCast, SubmonoidClass.coe_pow]
    exact (haarUnitaryAlgebra u).pow_mem
      (StarAlgebra.self_mem_adjoin_singleton 𝕜 (u : A)) n
  | negSucc n =>
    have hn : unitaryPower u ((n + 1 : ℕ) : ℤ) ∈ haarUnitaryAlgebra (𝕜 := 𝕜) u := by
      simp only [unitaryPower, zpow_natCast, SubmonoidClass.coe_pow]
      exact (haarUnitaryAlgebra u).pow_mem
        (StarAlgebra.self_mem_adjoin_singleton 𝕜 (u : A)) (n + 1)
    change unitaryPower u (-((n + 1 : ℕ) : ℤ)) ∈ haarUnitaryAlgebra (𝕜 := 𝕜) u
    rw [unitaryPower_neg]
    exact (StarAlgebra.adjoin 𝕜 ({(u : A)} : Set A)).star_mem' hn
end GeneratedAlgebra
end FreeProbability
