import FreeProbability.Algebraic.FreenessGroupingClosure
import Mathlib.Topology.Algebra.StarSubalgebra
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Basic
import Mathlib.Analysis.SpecialFunctions.ContinuousFunctionalCalculus.Rpow.Basic

/-! # Actual square roots belong to closed star-generated algebras -/

noncomputable section
open scoped Classical Pointwise
namespace FreeProbability
variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The actual closed star algebra generated by supplied ambient elements. -/
def closedStarGeneratedAlgebra (s : Set A) : StarSubalgebra ℂ A :=
  (StarAlgebra.adjoin ℂ s).topologicalClosure

/-- The actual ambient square root belongs to any closed star algebra containing
its positive input. Real functional calculus avoids a subtype order premise. -/
theorem sqrt_mem_starSubalgebra_topologicalClosure (S : StarSubalgebra ℂ A)
    (a : A) (ha : a ∈ S.topologicalClosure) (hapos : 0 ≤ a) :
    CFC.sqrt a ∈ S.topologicalClosure := by
  let : IsClosed (S.topologicalClosure : Set A) := isClosed_closure
  let x : S.topologicalClosure := ⟨a, ha⟩
  have hx : IsSelfAdjoint x := by
    apply Subtype.ext
    exact hapos.isSelfAdjoint.star_eq
  have hmap := S.topologicalClosure.subtype.toNonUnitalStarAlgHom.map_cfcₙ Real.sqrt x
    Real.continuous_sqrt.continuousOn (by simp) (by fun_prop) hx hapos.isSelfAdjoint
  change ((cfcₙ Real.sqrt x : S.topologicalClosure) : A) = cfcₙ Real.sqrt a at hmap
  rw [← CFC.sqrt_eq_real_sqrt a hapos] at hmap
  exact hmap ▸ (cfcₙ Real.sqrt x).property

omit [PartialOrder A] [StarOrderedRing A] in
/-- Star-stable generators have exactly the ordinary closed generated algebra
as their underlying algebra. -/
theorem closedStarGeneratedAlgebra_toSubalgebra (s : Set A)
    (hstar : ∀ a ∈ s, star a ∈ s) :
    (closedStarGeneratedAlgebra s).toSubalgebra = (Algebra.adjoin ℂ s).topologicalClosure := by
  rw [closedStarGeneratedAlgebra, StarSubalgebra.topologicalClosure_toSubalgebra_comm,
    StarAlgebra.adjoin_toSubalgebra]
  have hsub : star s ⊆ s := by
    intro a ha
    have hs : star a ∈ s := by simpa using ha
    simpa using hstar (star a) hs
  rw [Set.union_eq_left.mpr hsub]

omit [PartialOrder A] [StarOrderedRing A] in
/-- Self-adjoint generators are automatically star-stable. -/
theorem closedStarGeneratedAlgebra_toSubalgebra_of_selfAdjoint (s : Set A)
    (hs : ∀ a ∈ s, IsSelfAdjoint a) :
    (closedStarGeneratedAlgebra s).toSubalgebra = (Algebra.adjoin ℂ s).topologicalClosure :=
  closedStarGeneratedAlgebra_toSubalgebra s (fun a ha => by rw [(hs a ha).star_eq]; exact ha)
omit [PartialOrder A] [StarOrderedRing A] in
/-- Supplied generators belong to the actual closed generated star algebra. -/
theorem mem_closedStarGeneratedAlgebra {s : Set A} {a : A} (ha : a ∈ s) :
    a ∈ closedStarGeneratedAlgebra s :=
  (StarAlgebra.adjoin ℂ s).le_topologicalClosure (StarAlgebra.subset_adjoin ℂ s ha)

/-- Actual square roots stay in the same closed generated algebra. -/
theorem sqrt_mem_closedStarGeneratedAlgebra (s : Set A) (a : A)
    (ha : a ∈ closedStarGeneratedAlgebra s) (hapos : 0 ≤ a) :
    CFC.sqrt a ∈ closedStarGeneratedAlgebra s :=
  sqrt_mem_starSubalgebra_topologicalClosure (StarAlgebra.adjoin ℂ s) a ha hapos
end FreeProbability
