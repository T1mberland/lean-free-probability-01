import FreeProbability.Analytic.ProjectionProductFunctionalCalculus
import FreeProbability.Analytic.MultiplicativeResolventSandwich

/-! # Actual closed star algebras generated by grouped free positive elements -/

noncomputable section
open scoped Topology
namespace FreeProbability
variable {A I J : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The actual supplied elements in a grouping fiber. -/
def groupedElementSet (p : I → A) (g : I → J) (j : J) : Set A :=
  {a | ∃ i, g i = j ∧ a = p i}

omit [PartialOrder A] [StarOrderedRing A] in
/-- Grouping the individual generated algebras gives precisely the algebra
of the actual generators in the same grouping fiber. -/
theorem groupedSubalgebra_singleton_eq (p : I → A) (g : I → J) (j : J) :
    groupedSubalgebra (fun i => Algebra.adjoin ℂ {p i}) g j =
      Algebra.adjoin ℂ (groupedElementSet p g j) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro a ⟨i, hi, ha⟩
    have hle : Algebra.adjoin ℂ {p i} ≤ Algebra.adjoin ℂ (groupedElementSet p g j) := by
      apply Algebra.adjoin_le
      intro a ha
      exact Algebra.subset_adjoin ⟨i, hi, Set.mem_singleton_iff.mp ha⟩
    exact hle ha
  · apply Algebra.adjoin_le
    rintro a ⟨i, hi, rfl⟩
    exact Algebra.subset_adjoin ⟨i, hi, Algebra.subset_adjoin (Set.mem_singleton (p i))⟩

omit [PartialOrder A] [StarOrderedRing A] in
/-- Self-adjoint grouped elements identify the genuine closed star algebra
with the closed grouped algebra used by the freeness theorem. -/
theorem closedStarGeneratedAlgebra_grouped_eq (p : I → A) (g : I → J)
    (hp : ∀ i, IsSelfAdjoint (p i)) (j : J) :
    (closedStarGeneratedAlgebra (groupedElementSet p g j)).toSubalgebra =
      (groupedSubalgebra (fun i => Algebra.adjoin ℂ {p i}) g j).topologicalClosure := by
  rw [groupedSubalgebra_singleton_eq]
  apply closedStarGeneratedAlgebra_toSubalgebra_of_selfAdjoint
  rintro a ⟨i, _, rfl⟩
  exact hp i

namespace StarProbabilitySpace
variable (φ : FreeProbability.StarProbabilitySpace A)

/-- Closed star algebras of disjoint groups of actual self-adjoint free
variables are free. No prefix freeness or square-root membership is assumed. -/
theorem freelyIndependent_closedStarGrouped {B : I → Subalgebra ℂ A}
    (hf : FreelyIndependent φ.toProbabilitySpace B) (p : I → A)
    (hpB : ∀ i, p i ∈ B i) (hp : ∀ i, IsSelfAdjoint (p i)) (g : I → J) :
    FreelyIndependent φ.toProbabilitySpace
      (fun j => (closedStarGeneratedAlgebra (groupedElementSet p g j)).toSubalgebra) := by
  have hsmall : FreelyIndependent φ.toProbabilitySpace (fun i => Algebra.adjoin ℂ {p i}) :=
    hf.mono (fun i => Algebra.adjoin_le (by
      intro a ha
      rw [Set.mem_singleton_iff.mp ha]
      exact hpB i))
  have hclosed := hsmall.groupedSubalgebra_topologicalClosure φ.continuous_expectation g
  simpa only [closedStarGeneratedAlgebra_grouped_eq p g hp] using hclosed

/-- The actual sandwich S-transform between two supplied disjoint groups
factors, with grouped freeness discharged from the original family. -/
theorem sTransform_grouped_positiveMultiplicativeSandwich_eventually
    (hφ : IsTracial φ.toProbabilitySpace) {B : I → Subalgebra ℂ A}
    (hf : FreelyIndependent φ.toProbabilitySpace B) (p : I → A)
    (hpB : ∀ i, p i ∈ B i) (hp : ∀ i, IsSelfAdjoint (p i)) (g : I → J)
    {j k : J} (hjk : j ≠ k) (a b : A)
    (ha : a ∈ closedStarGeneratedAlgebra (groupedElementSet p g j))
    (hb : b ∈ closedStarGeneratedAlgebra (groupedElementSet p g k))
    (hapos : 0 ≤ a) (hEa : φ.expectation a ≠ 0) (hEb : φ.expectation b ≠ 0) :
    φ.sTransform (positiveMultiplicativeSandwich a b)
      (φ.expectation_positiveMultiplicativeSandwich_ne_zero hφ
        (φ.freelyIndependent_closedStarGrouped hf p hpB hp g) hjk a b ha hb hapos hEa hEb)
      =ᶠ[𝓝 0] (fun w => φ.sTransform a hEa w * φ.sTransform b hEb w) :=
  φ.sTransform_positiveMultiplicativeSandwich_eventually hφ
    (φ.freelyIndependent_closedStarGrouped hf p hpB hp g) hjk a b ha hb hapos hEa hEb
end StarProbabilitySpace
end FreeProbability
