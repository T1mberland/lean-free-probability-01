import FreeProbability.Fock.GeneratedState
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Faithful tracial state on the closed generated semicircular algebra

The operator-norm closure is an actual complete star algebra of bounded word
operators. Faithfulness uses commuting right operators, and traciality extends
from polynomial operators by continuity in both factors.
-/

noncomputable section
open scoped Classical InnerProductSpace ComplexOrder

namespace FreeProbability.Fock

variable {I : Type*}

/-- The operator-norm-closed algebra generated by the canonical semicircular operators. -/
def closedSemicircularAlgebra (I : Type*) :
    StarSubalgebra ℂ (WordSpace I →L[ℂ] WordSpace I) :=
  (semicircularAlgebra I).topologicalClosure

instance (I : Type*) : CompleteSpace (closedSemicircularAlgebra I) := by
  unfold closedSemicircularAlgebra
  infer_instance

/-- Continuity of the vacuum functional, with the previously proved bound one. -/
def vacuumContinuous (I : Type*) : (WordSpace I →L[ℂ] WordSpace I) →L[ℂ] ℂ :=
  (vacuumLinear (I := I)).mkContinuous 1 (fun T => by
    change ‖vacuumExpectation T‖ ≤ 1 * ‖T‖
    simpa using norm_vacuumExpectation_le T)

@[simp] theorem vacuumContinuous_apply (T : WordSpace I →L[ℂ] WordSpace I) :
    vacuumContinuous I T = vacuumExpectation T := rfl

/-- Commutation persists in the norm closure. -/
theorem commute_right_of_mem_closedSemicircularAlgebra
    {T : WordSpace I →L[ℂ] WordSpace I} (hT : T ∈ closedSemicircularAlgebra I) (i : I) :
    Commute T (rightSemicircular i) := by
  exact closure_minimal
    (fun U hU => (commute_right_of_mem_semicircularAlgebra hU i).eq)
    (isClosed_eq (continuous_id.mul continuous_const) (continuous_const.mul continuous_id)) hT

/-- Faithfulness holds on the norm closure, not only on polynomial operators. -/
theorem vacuumExpectation_faithful_on_closedSemicircularAlgebra
    {T : WordSpace I →L[ℂ] WordSpace I} (hT : T ∈ closedSemicircularAlgebra I)
    (hzero : vacuumExpectation (star T * T) = 0) : T = 0 := by
  apply eq_zero_of_commute_right_of_vacuum_eq_zero T
    (commute_right_of_mem_closedSemicircularAlgebra hT)
  rw [vacuumExpectation_star_mul_self, sq_eq_zero_iff, Complex.ofReal_eq_zero,
    norm_eq_zero] at hzero
  exact hzero

/-- Traciality extends to both factors of the closed generated algebra. -/
theorem vacuumExpectation_mul_comm_on_closedSemicircularAlgebra
    {T U : WordSpace I →L[ℂ] WordSpace I}
    (hT : T ∈ closedSemicircularAlgebra I) (hU : U ∈ closedSemicircularAlgebra I) :
    vacuumExpectation (T * U) = vacuumExpectation (U * T) := by
  have hpoly : ∀ V ∈ semicircularAlgebra I,
      vacuumExpectation (T * V) = vacuumExpectation (V * T) := by
    intro V hV
    exact closure_minimal
      (fun W hW => vacuumExpectation_mul_comm_on_semicircularAlgebra hW hV)
      (isClosed_eq
        ((vacuumContinuous I).continuous.comp (continuous_id.mul continuous_const))
        ((vacuumContinuous I).continuous.comp (continuous_const.mul continuous_id))) hT
  exact closure_minimal hpoly
    (isClosed_eq
      ((vacuumContinuous I).continuous.comp (continuous_const.mul continuous_id))
      ((vacuumContinuous I).continuous.comp (continuous_id.mul continuous_const))) hU

/-- The positive normalized state on the closed generated algebra. -/
def closedGeneratedVacuumState (I : Type*) : StarProbabilitySpace (closedSemicircularAlgebra I) where
  expectation := vacuumLinear.comp (closedSemicircularAlgebra I).val.toLinearMap
  map_one := vacuumExpectation_one
  map_star T := vacuumExpectation_star (T : WordSpace I →L[ℂ] WordSpace I)
  positive T := (vacuumState I).positive (T : WordSpace I →L[ℂ] WordSpace I)

/-- The closed generated vacuum state is faithful. -/
theorem closedGeneratedVacuumState_isFaithful (I : Type*) :
    IsFaithful (closedGeneratedVacuumState I).toProbabilitySpace := by
  intro T hT
  apply Subtype.ext
  exact vacuumExpectation_faithful_on_closedSemicircularAlgebra T.property hT

/-- The closed generated vacuum state is tracial. -/
theorem closedGeneratedVacuumState_tracial (I : Type*)
    (T U : closedSemicircularAlgebra I) :
    (closedGeneratedVacuumState I).expectation (T * U) =
      (closedGeneratedVacuumState I).expectation (U * T) :=
  vacuumExpectation_mul_comm_on_closedSemicircularAlgebra T.property U.property

end FreeProbability.Fock
