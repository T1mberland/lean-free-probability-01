import FreeProbability.Fock.OrthonormalFamily
import FreeProbability.Fock.WickFormula
import FreeProbability.Fock.CatalanMoments

/-! # The literal closed C-star probability model generated by an orthonormal family -/

noncomputable section
open scoped Classical

namespace FreeProbability.Fock.OrthonormalFamilyExtension

variable {I H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  {e : I → H} (d : OrthonormalFamilyExtension e)

/-- The literal norm-closed star algebra generated by the prescribed family only. -/
def generatedAlgebra : StarSubalgebra ℂ (d.Space →L[ℂ] d.Space) :=
  (StarAlgebra.adjoin ℂ (Set.range d.field)).topologicalClosure

instance : CompleteSpace d.generatedAlgebra := by
  unfold generatedAlgebra
  infer_instance

instance : IsClosed (d.generatedAlgebra : Set (d.Space →L[ℂ] d.Space)) :=
  (StarAlgebra.adjoin ℂ (Set.range d.field)).isClosed_topologicalClosure

example : CStarAlgebra d.generatedAlgebra := inferInstance

/-- The prescribed-family algebra is contained in the full extension's canonical closed algebra. -/
theorem generatedAlgebra_le : d.generatedAlgebra ≤ closedSemicircularAlgebra d.indices := by
  apply StarSubalgebra.topologicalClosure_minimal
  · apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    rw [d.field_eq_semicircular]
    exact (semicircularAlgebra d.indices).le_topologicalClosure
      (semicircular_mem_algebra _)
  · exact (semicircularAlgebra d.indices).isClosed_topologicalClosure

/-- The actual positive normalized vacuum state on the literal family-generated algebra. -/
def state : StarProbabilitySpace d.generatedAlgebra where
  expectation := vacuumLinear.comp d.generatedAlgebra.val.toLinearMap
  map_one := vacuumExpectation_one
  map_star T := vacuumExpectation_star (T : d.Space →L[ℂ] d.Space)
  positive T := (vacuumState d.indices).positive (T : d.Space →L[ℂ] d.Space)

theorem state_isFaithful : IsFaithful d.state.toProbabilitySpace := by
  intro T hzero
  apply Subtype.ext
  exact vacuumExpectation_faithful_on_closedSemicircularAlgebra
    (d.generatedAlgebra_le T.property) hzero

theorem state_isTracial : IsTracial d.state.toProbabilitySpace := by
  intro T U
  exact vacuumExpectation_mul_comm_on_closedSemicircularAlgebra
    (d.generatedAlgebra_le T.property) (d.generatedAlgebra_le U.property)

/-- Each actual field is an element of the literal family-generated C-star algebra. -/
def generator (i : I) : d.generatedAlgebra :=
  ⟨d.field i, (StarAlgebra.adjoin ℂ (Set.range d.field)).le_topologicalClosure
    (StarAlgebra.subset_adjoin ℂ (Set.range d.field) ⟨i, rfl⟩)⟩

@[simp] theorem coe_generator (i : I) :
    (d.generator i : d.Space →L[ℂ] d.Space) = d.field i := rfl

@[simp] theorem norm_generator (i : I) : ‖d.generator i‖ = 2 := d.norm_field i

theorem isSelfAdjoint_generator (i : I) : IsSelfAdjoint (d.generator i) := by
  apply Subtype.ext
  exact (d.isSelfAdjoint_field i).star_eq

/-- Actual norm-closed singleton algebras inside the literal family-generated algebra. -/
def generatorAlgebra (i : I) : Subalgebra ℂ d.generatedAlgebra :=
  (Algebra.adjoin ℂ ({d.field i} : Set _)).topologicalClosure.comap d.generatedAlgebra.val

theorem freelyIndependent_state :
    FreelyIndependent d.state.toProbabilitySpace d.generatorAlgebra := by
  intro w hw halt hmem hzero
  let g : I × d.generatedAlgebra → d.indices × (d.Space →L[ℂ] d.Space) :=
    fun x => (d.index x.1, x.2)
  have halt' : (w.map g).IsChain (fun x y => x.1 ≠ y.1) :=
    (List.isChain_map g).mpr
      (halt.imp (fun x y hxy h => hxy (d.index_injective h)))
  have hm : ∀ x ∈ w.map g,
      x.2 ∈ (Algebra.adjoin ℂ ({semicircular x.1} : Set _)).topologicalClosure := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    have hh := hmem y hy
    change (y.2 : d.Space →L[ℂ] d.Space) ∈
      (Algebra.adjoin ℂ ({d.field y.1} : Set _)).topologicalClosure at hh
    simpa only [d.field_eq_semicircular] using hh
  have hz : ∀ x ∈ w.map g, (vacuumState d.indices).expectation x.2 = 0 := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact hzero y hy
  have hr := freelyIndependent_semicircular_closed d.indices (w.map g)
    (by simpa using hw) halt' hm hz
  change vacuumExpectation (((w.map Prod.snd).prod : d.generatedAlgebra) :
    d.Space →L[ℂ] d.Space) = 0
  simpa [g, List.map_map, Function.comp_def, map_list_prod] using hr

/-- The literal all-order noncrossing-pairing joint law of the prescribed family. -/
theorem joint_wick (n : ℕ) (a : Fin n → I) :
    d.state.expectation (List.ofFn (fun k => d.generator (a k))).prod =
      ∑ p : FreeProbability.NoncrossingPairing n,
        ∏ q ∈ FreeProbability.NoncrossingPairing.pairingPairs p,
          if a q.1 = a q.2 then (1 : ℂ) else 0 := by
  change vacuumExpectation (d.generatedAlgebra.val
    (List.ofFn (fun k => d.generator (a k))).prod) = _
  rw [map_list_prod, List.map_ofFn]
  change vacuumExpectation (List.ofFn (fun k => d.field (a k))).prod = _
  simp only [d.field_eq_semicircular]
  simpa only [operatorWord, List.map_ofFn, Function.comp_def,
    d.index_injective.eq_iff] using joint_free_wick n (fun k => d.index (a k))

/-- Actual even moments, without assuming a semicircular law. -/
theorem even_moment (i : I) (n : ℕ) :
    d.state.expectation (d.generator i ^ (2 * n)) = (catalan n : ℂ) := by
  change vacuumExpectation (d.generatedAlgebra.val (d.generator i ^ (2 * n))) = _
  rw [map_pow]
  change vacuumExpectation (d.field i ^ (2 * n)) = _
  rw [d.field_eq_semicircular]
  exact vacuumExpectation_semicircular_even (d.index i) n

/-- Actual odd moments of every prescribed generator vanish. -/
theorem odd_moment (i : I) (n : ℕ) :
    d.state.expectation (d.generator i ^ (2 * n + 1)) = 0 := by
  change vacuumExpectation (d.generatedAlgebra.val (d.generator i ^ (2 * n + 1))) = _
  rw [map_pow]
  change vacuumExpectation (d.field i ^ (2 * n + 1)) = _
  rw [d.field_eq_semicircular]
  exact vacuumExpectation_semicircular_odd (d.index i) n

end FreeProbability.Fock.OrthonormalFamilyExtension
