import FreeProbability.Fock.SecondQuantizationWOTCompression
import FreeProbability.Fock.OrnsteinUhlenbeckEmbeddingCompression

/-! # Actual WOT-generated field algebras and their reducing projection

The closure here uses the genuine weak operator topology. No inverse embedding
continuity or von Neumann normal-extension assertion is included.
-/
noncomputable section
open scoped Classical
namespace FreeProbability.Fock
variable {I H K : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- Actual weak-operator closure of the unital star algebra generated by the real fields. -/
def tensorFamilyWOTAlgebra (e : I → H) :
    StarSubalgebra ℂ (TensorFullFock H →WOT[ℂ] TensorFullFock H) :=
  (StarAlgebra.adjoin ℂ (Set.range (fun i =>
    ContinuousLinearMapWOT.ofCLM (tensorFamilyField e i)))).topologicalClosure

theorem tensorFamilyWOTAlgebra_commutes_inclusionProjection (V : H →ₗᵢ[ℂ] K) (e : I → H)
    {T : TensorFullFock K →WOT[ℂ] TensorFullFock K}
    (hT : T ∈ tensorFamilyWOTAlgebra (fun i => V (e i))) :
    fockInclusionProjection V * T.toCLM = T.toCLM * fockInclusionProjection V := by
  let P := ContinuousLinearMapWOT.ofCLM (fockInclusionProjection V)
  let B := StarSubalgebra.centralizer ℂ ({P} : Set _)
  have hp : StarAlgebra.adjoin ℂ (Set.range (fun i =>
      ContinuousLinearMapWOT.ofCLM (tensorFamilyField (fun j => V (e j)) i))) ≤ B := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    apply (StarSubalgebra.mem_centralizer_iff ℂ).mpr
    intro Q hQ
    have he : Q = P := Set.mem_singleton_iff.mp hQ
    subst Q
    have hs : star P = P := congrArg ContinuousLinearMapWOT.ofCLM
      (fockInclusionProjection_star V)
    rw [hs]
    exact ⟨congrArg ContinuousLinearMapWOT.ofCLM
      (tensorFamilyField_commutes_inclusionProjection V e i).symm,
      congrArg ContinuousLinearMapWOT.ofCLM
      (tensorFamilyField_commutes_inclusionProjection V e i).symm⟩
  have hc : IsClosed (B : Set (TensorFullFock K →WOT[ℂ] TensorFullFock K)) := by
    change IsClosed (({P} ∪ star {P} : Set _).centralizer)
    exact Set.isClosed_centralizer _
  have hb := StarSubalgebra.topologicalClosure_minimal hp hc hT
  exact congrArg ContinuousLinearMapWOT.toCLM
    ((((StarSubalgebra.mem_centralizer_iff ℂ).mp hb) P (Set.mem_singleton P)).1)

/-- Every operator in the actual WOT closure intertwines with its actual compression. -/
theorem tensorFamilyWOTAlgebra_inclusion_comp (V : H →ₗᵢ[ℂ] K) (e : I → H)
    {T : TensorFullFock K →WOT[ℂ] TensorFullFock K}
    (hT : T ∈ tensorFamilyWOTAlgebra (fun i => V (e i))) :
    T.toCLM.comp (secondQuantizationIsometry V).toContinuousLinearMap =
      (secondQuantizationIsometry V).toContinuousLinearMap.comp
        (secondQuantizationCompression V T.toCLM) := by
  let W := (secondQuantizationIsometry V).toContinuousLinearMap
  have hp : (fockInclusionProjection V).comp W = W := by
    change (W.comp W.adjoint).comp W = W
    rw [ContinuousLinearMap.comp_assoc, secondQuantizationIsometry_adjoint_comp]
    rfl
  have ht := tensorFamilyWOTAlgebra_commutes_inclusionProjection V e hT
  change (fockInclusionProjection V).comp T.toCLM = T.toCLM.comp (fockInclusionProjection V) at ht
  change T.toCLM.comp W = W.comp (W.adjoint.comp (T.toCLM.comp W))
  calc
    T.toCLM.comp W = T.toCLM.comp ((fockInclusionProjection V).comp W) :=
      congrArg T.toCLM.comp hp.symm
    _ = ((fockInclusionProjection V).comp T.toCLM).comp W := by
      rw [← ContinuousLinearMap.comp_assoc, ← ht]
    _ = _ := by
      change ((W.comp W.adjoint).comp T.toCLM).comp W = _
      rw [ContinuousLinearMap.comp_assoc, ContinuousLinearMap.comp_assoc]

/-- Restricted multiplicativity is genuine; the left factor may be any ambient operator. -/
theorem tensorFamilyWOTAlgebra_compression_mul (V : H →ₗᵢ[ℂ] K) (e : I → H)
    (T S : TensorFullFock K →WOT[ℂ] TensorFullFock K)
    (hS : S ∈ tensorFamilyWOTAlgebra (fun i => V (e i))) :
    secondQuantizationCompressionWOT V (T * S) =
      secondQuantizationCompressionWOT V T * secondQuantizationCompressionWOT V S := by
  have hs := tensorFamilyWOTAlgebra_inclusion_comp V e hS
  apply ContinuousLinearMapWOT.toCLM_injective
  change (secondQuantizationIsometry V).toContinuousLinearMap.adjoint.comp
      ((T.toCLM.comp S.toCLM).comp (secondQuantizationIsometry V).toContinuousLinearMap) = _
  rw [ContinuousLinearMap.comp_assoc, hs]
  rfl

end FreeProbability.Fock
