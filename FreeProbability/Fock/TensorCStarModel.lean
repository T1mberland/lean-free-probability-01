import FreeProbability.Fock.TensorSemicircular

/-! # The actual faithful tracial generated C-star algebra on tensor Fock space -/

noncomputable section
open scoped Classical

namespace FreeProbability.Fock

variable (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The literal norm-closed star algebra generated by the selected tensor fields. -/
def tensorClosedSemicircularAlgebra : StarSubalgebra ℂ (TensorFullFock H →L[ℂ] TensorFullFock H) :=
  (StarAlgebra.adjoin ℂ (Set.range (tensorSemicircular H))).topologicalClosure

instance : CompleteSpace (tensorClosedSemicircularAlgebra H) := by
  unfold tensorClosedSemicircularAlgebra
  infer_instance

instance : IsClosed (tensorClosedSemicircularAlgebra H : Set (TensorFullFock H →L[ℂ] TensorFullFock H)) :=
  (StarAlgebra.adjoin ℂ (Set.range (tensorSemicircular H))).isClosed_topologicalClosure

example : CStarAlgebra (tensorClosedSemicircularAlgebra H) := inferInstance

/-- Actual closed generated tensors transport into the verified closed canonical algebra. -/
theorem tensorClosedSemicircularAlgebra_maps_into
    {T : TensorFullFock H →L[ℂ] TensorFullFock H} (hT : T ∈ tensorClosedSemicircularAlgebra H) :
    (tensorOperatorEquiv H).symm T ∈ closedSemicircularAlgebra (fullFockBasisSet H) := by
  let B := (closedSemicircularAlgebra (fullFockBasisSet H)).comap
    (tensorOperatorEquiv H).symm.toStarAlgHom
  have hp : StarAlgebra.adjoin ℂ (Set.range (tensorSemicircular H)) ≤ B := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    change (tensorOperatorEquiv H).symm (tensorSemicircular H i) ∈ closedSemicircularAlgebra _
    rw [tensorSemicircular_eq_transport, StarAlgEquiv.symm_apply_apply]
    exact (semicircularAlgebra (fullFockBasisSet H)).le_topologicalClosure
      (StarAlgebra.subset_adjoin ℂ (Set.range (semicircular (I := fullFockBasisSet H))) ⟨i, rfl⟩)
  have hc : IsClosed (B : Set (TensorFullFock H →L[ℂ] TensorFullFock H)) := by
    exact (semicircularAlgebra (fullFockBasisSet H)).isClosed_topologicalClosure.preimage
      (fullFockTensorDecomposition H).symm.toContinuousLinearEquiv.conjContinuousAlgEquiv.continuous
  exact StarSubalgebra.topologicalClosure_minimal hp hc hT

/-- Restriction of the actual tensor vacuum state to its literal closed generated algebra. -/
def tensorClosedVacuumState : StarProbabilitySpace (tensorClosedSemicircularAlgebra H) where
  expectation := (tensorVacuumState H).expectation.comp (tensorClosedSemicircularAlgebra H).val.toLinearMap
  map_one := (tensorVacuumState H).map_one
  map_star T := (tensorVacuumState H).map_star (T : TensorFullFock H →L[ℂ] TensorFullFock H)
  positive T := (tensorVacuumState H).positive (T : TensorFullFock H →L[ℂ] TensorFullFock H)

/-- Faithfulness is proved for the literal generated closure, not all tensor operators. -/
theorem tensorClosedVacuumState_isFaithful : IsFaithful (tensorClosedVacuumState H).toProbabilitySpace := by
  intro T hzero
  apply Subtype.ext
  apply (tensorOperatorEquiv H).symm.injective
  have he : (tensorOperatorEquiv H).symm (T : TensorFullFock H →L[ℂ] TensorFullFock H) = 0 := by
    apply vacuumExpectation_faithful_on_closedSemicircularAlgebra
      (tensorClosedSemicircularAlgebra_maps_into H T.property)
    change vacuumExpectation ((tensorOperatorEquiv H).symm
      (star (T : TensorFullFock H →L[ℂ] TensorFullFock H) * T)) = 0 at hzero
    simpa only [map_mul, map_star] using hzero
  change (tensorOperatorEquiv H).symm (T : TensorFullFock H →L[ℂ] TensorFullFock H) =
    (tensorOperatorEquiv H).symm (0 : TensorFullFock H →L[ℂ] TensorFullFock H)
  rw [map_zero]
  exact he

/-- The actual tensor-generated closed C-star state is tracial. -/
theorem tensorClosedVacuumState_tracial : IsTracial (tensorClosedVacuumState H).toProbabilitySpace := by
  intro T U
  change vacuumExpectation ((tensorOperatorEquiv H).symm
    ((T : TensorFullFock H →L[ℂ] TensorFullFock H) * U)) =
      vacuumExpectation ((tensorOperatorEquiv H).symm ((U : TensorFullFock H →L[ℂ] TensorFullFock H) * T))
  rw [map_mul, map_mul]
  exact vacuumExpectation_mul_comm_on_closedSemicircularAlgebra
    (tensorClosedSemicircularAlgebra_maps_into H T.property)
    (tensorClosedSemicircularAlgebra_maps_into H U.property)

/-- The chosen semicircular generators are genuine elements of the faithful tracial C-star algebra. -/
def tensorClosedSemicircular (i : fullFockBasisSet H) : tensorClosedSemicircularAlgebra H :=
  ⟨tensorSemicircular H i, (StarAlgebra.adjoin ℂ (Set.range (tensorSemicircular H))).le_topologicalClosure
    (StarAlgebra.subset_adjoin ℂ (Set.range (tensorSemicircular H)) ⟨i, rfl⟩)⟩

@[simp] theorem norm_tensorClosedSemicircular (i : fullFockBasisSet H) :
    ‖tensorClosedSemicircular H i‖ = 2 := norm_tensorSemicircular H i

/-- Closed singleton algebras, regarded inside the actual faithful tracial C-star ambient algebra. -/
def tensorClosedGeneratorAlgebra (i : fullFockBasisSet H) :
    Subalgebra ℂ (tensorClosedSemicircularAlgebra H) :=
  (Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _)).topologicalClosure.comap
    (tensorClosedSemicircularAlgebra H).val

theorem tensorClosedSemicircular_mem_closedGeneratorAlgebra (i : fullFockBasisSet H) :
    tensorClosedSemicircular H i ∈ tensorClosedGeneratorAlgebra H i :=
  (Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _)).le_topologicalClosure
    (Algebra.self_mem_adjoin_singleton ℂ (tensorSemicircular H i))

/-- Actual freeness lives inside the concrete faithful tracial tensor C-star probability space. -/
theorem freelyIndependent_tensorClosedVacuumState :
    FreelyIndependent (𝕜 := ℂ) (A := tensorClosedSemicircularAlgebra H)
      (I := fullFockBasisSet H) (tensorClosedVacuumState H).toProbabilitySpace
      (tensorClosedGeneratorAlgebra H) := by
  intro w hw halt hmem hzero
  let f := (tensorClosedSemicircularAlgebra H).val
  let g : fullFockBasisSet H × tensorClosedSemicircularAlgebra H →
      fullFockBasisSet H × (TensorFullFock H →L[ℂ] TensorFullFock H) := fun x => (x.1, f x.2)
  have halt' : (w.map g).IsChain (fun x y => x.1 ≠ y.1) := (List.isChain_map g).mpr halt
  have hm : ∀ x ∈ w.map g,
      x.2 ∈ (Algebra.adjoin ℂ ({tensorSemicircular H x.1} : Set _)).topologicalClosure := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact hmem y hy
  have hz : ∀ x ∈ w.map g, (tensorVacuumState H).expectation x.2 = 0 := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact hzero y hy
  have hr := freelyIndependent_tensorSemicircular_closed H (w.map g) (by simpa using hw) halt' hm hz
  change (tensorVacuumState H).expectation (f (w.map Prod.snd).prod) = 0
  simpa [g, List.map_map, Function.comp_def, map_list_prod, f] using hr

end FreeProbability.Fock
