import FreeProbability.Fock.TensorBasisTransportOperators

/-!
# Faithful tracial vacuum state for any orthonormal family on fixed tensor Fock space

The algebra is the actual norm-closed star algebra generated by the prescribed
orthonormal real fields. Its carrier is the independently fixed recursively
completed tensor Fock space. No spanning, countability, or nontriviality is assumed.
-/
noncomputable section
open scoped Classical
namespace FreeProbability.Fock
variable {I H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The actual field of the prescribed vector on fixed completed tensor Fock space. -/
def tensorFamilyField (e : I → H) (i : I) : TensorFullFock H →L[ℂ] TensorFullFock H :=
  tensorCreation H (e i) + tensorAnnihilation H (e i)

/-- Literal norm-closed star algebra generated by this family alone. -/
def tensorFamilyAlgebra (e : I → H) : StarSubalgebra ℂ (TensorFullFock H →L[ℂ] TensorFullFock H) :=
  (StarAlgebra.adjoin ℂ (Set.range (tensorFamilyField e))).topologicalClosure

instance (e : I → H) : CompleteSpace (tensorFamilyAlgebra e) := by
  unfold tensorFamilyAlgebra
  infer_instance

instance (e : I → H) : IsClosed (tensorFamilyAlgebra e : Set (TensorFullFock H →L[ℂ] TensorFullFock H)) :=
  (StarAlgebra.adjoin ℂ (Set.range (tensorFamilyField e))).isClosed_topologicalClosure

/-- Positive normalized actual vacuum state, restricted to the literal family-generated algebra. -/
def tensorFamilyVacuumState (e : I → H) : StarProbabilitySpace (tensorFamilyAlgebra e) where
  expectation := (tensorVacuumState H).expectation.comp (tensorFamilyAlgebra e).val.toLinearMap
  map_one := (tensorVacuumState H).map_one
  map_star T := (tensorVacuumState H).map_star (T : TensorFullFock H →L[ℂ] TensorFullFock H)
  positive T := (tensorVacuumState H).positive (T : TensorFullFock H →L[ℂ] TensorFullFock H)

namespace OrthonormalFamilyExtension
variable {e : I → H} (d : OrthonormalFamilyExtension e)

/-- The genuine inverse operator unitary carries the fixed generated closure into the adapted closure. -/
theorem tensorFamilyAlgebra_maps_into
    {T : TensorFullFock H →L[ℂ] TensorFullFock H} (hT : T ∈ tensorFamilyAlgebra e) :
    d.tensorOperatorTransport.symm T ∈ d.generatedAlgebra := by
  let B := d.generatedAlgebra.comap d.tensorOperatorTransport.symm.toStarAlgHom
  have hp : StarAlgebra.adjoin ℂ (Set.range (tensorFamilyField e)) ≤ B := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    change d.tensorOperatorTransport.symm (tensorFamilyField e i) ∈ d.generatedAlgebra
    have he : d.tensorOperatorTransport.symm (tensorFamilyField e i) = d.field i := by
      apply d.tensorOperatorTransport.injective
      change d.tensorOperatorTransport (d.tensorOperatorTransport.symm (tensorFamilyField e i)) =
        d.tensorOperatorTransport (d.field i)
      rw [StarAlgEquiv.apply_symm_apply, d.tensorOperatorTransport_field]
      rfl
    rw [he]
    exact (d.generator i).property
  have hc : IsClosed (B : Set (TensorFullFock H →L[ℂ] TensorFullFock H)) :=
    (StarAlgebra.adjoin ℂ (Set.range d.field)).isClosed_topologicalClosure.preimage
      d.tensorTransport.symm.toContinuousLinearEquiv.conjContinuousAlgEquiv.continuous
  exact StarSubalgebra.topologicalClosure_minimal hp hc hT

/-- Forward operator transport sends the adapted generated closure into the literal fixed closure. -/
theorem generatedAlgebra_maps_into_tensorFamily
    {T : d.Space →L[ℂ] d.Space} (hT : T ∈ d.generatedAlgebra) :
    d.tensorOperatorTransport T ∈ tensorFamilyAlgebra e := by
  let B := (tensorFamilyAlgebra e).comap d.tensorOperatorTransport.toStarAlgHom
  have hp : StarAlgebra.adjoin ℂ (Set.range d.field) ≤ B := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    change d.tensorOperatorTransport (d.field i) ∈ tensorFamilyAlgebra e
    rw [d.tensorOperatorTransport_field]
    exact (StarAlgebra.adjoin ℂ (Set.range (tensorFamilyField e))).le_topologicalClosure
      (StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩)
  have hc : IsClosed (B : Set (d.Space →L[ℂ] d.Space)) :=
    (StarAlgebra.adjoin ℂ (Set.range (tensorFamilyField e))).isClosed_topologicalClosure.preimage
      d.tensorTransport.toContinuousLinearEquiv.conjContinuousAlgEquiv.continuous
  exact StarSubalgebra.topologicalClosure_minimal hp hc hT

/-- Faithfulness on the fixed actual closure, via genuine unitary transport to the adapted model. -/
theorem tensorFamilyVacuumState_isFaithful (d : OrthonormalFamilyExtension e) : IsFaithful (tensorFamilyVacuumState e).toProbabilitySpace := by
  intro T hzero
  let U : d.generatedAlgebra := ⟨d.tensorOperatorTransport.symm T, d.tensorFamilyAlgebra_maps_into T.property⟩
  have hu : d.state.expectation (star U * U) = 0 := by
    have he := d.tensorOperatorTransport_symm_expectation
      (star (T : TensorFullFock H →L[ℂ] TensorFullFock H) * T)
    rw [map_mul, map_star] at he
    change vacuumExpectation (star (d.tensorOperatorTransport.symm T) * d.tensorOperatorTransport.symm T) = 0
    exact he.trans hzero
  have hz := d.state_isFaithful U hu
  apply Subtype.ext
  apply d.tensorOperatorTransport.symm.injective
  have hv := congrArg (fun X : d.generatedAlgebra => (X : d.Space →L[ℂ] d.Space)) hz
  change d.tensorOperatorTransport.symm (T : TensorFullFock H →L[ℂ] TensorFullFock H) =
    d.tensorOperatorTransport.symm (0 : TensorFullFock H →L[ℂ] TensorFullFock H)
  rw [map_zero]
  exact hv

/-- Traciality on the fixed literal family closure; no claim is made for all complex vector fields. -/
theorem tensorFamilyVacuumState_isTracial (d : OrthonormalFamilyExtension e) : IsTracial (tensorFamilyVacuumState e).toProbabilitySpace := by
  intro T S
  let U : d.generatedAlgebra := ⟨d.tensorOperatorTransport.symm T, d.tensorFamilyAlgebra_maps_into T.property⟩
  let V : d.generatedAlgebra := ⟨d.tensorOperatorTransport.symm S, d.tensorFamilyAlgebra_maps_into S.property⟩
  have ht := d.tensorOperatorTransport_symm_expectation
    ((T : TensorFullFock H →L[ℂ] TensorFullFock H) * S)
  have hs := d.tensorOperatorTransport_symm_expectation
    ((S : TensorFullFock H →L[ℂ] TensorFullFock H) * T)
  rw [map_mul] at ht hs
  exact ht.symm.trans ((d.state_isTracial U V).trans hs)
end OrthonormalFamilyExtension

/-- Every orthonormal family has faithful vacuum state in the independently fixed tensor Fock model. -/
theorem tensorFamilyVacuumState_faithful (e : I → H) (he : Orthonormal ℂ e) :
    IsFaithful (tensorFamilyVacuumState e).toProbabilitySpace :=
  (orthonormalFamilyExtension he).tensorFamilyVacuumState_isFaithful

/-- Every orthonormal family's literal fixed-model generated algebra has a tracial vacuum state. -/
theorem tensorFamilyVacuumState_tracial (e : I → H) (he : Orthonormal ℂ e) :
    IsTracial (tensorFamilyVacuumState e).toProbabilitySpace :=
  (orthonormalFamilyExtension he).tensorFamilyVacuumState_isTracial

end FreeProbability.Fock
