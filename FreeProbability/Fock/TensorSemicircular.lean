import FreeProbability.Fock.TensorOperators
import FreeProbability.Fock.FreeCStarModel

/-!
# A genuine free semicircular family on completed-tensor Fock space

Only the chosen orthonormal basis vectors index this free semicircular family.
The vacuum state is positive on all operators; its faithfulness and traciality
are reserved for the generated algebra, rather than all bounded operators.
-/

noncomputable section
open scoped Classical InnerProductSpace ComplexOrder

namespace FreeProbability.Fock

variable (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Vacuum state transported onto the actual completed-tensor domain. -/
def tensorVacuumState : StarProbabilitySpace (TensorFullFock H →L[ℂ] TensorFullFock H) where
  toProbabilitySpace := (vacuumState (fullFockBasisSet H)).toProbabilitySpace.comap
    (tensorOperatorEquiv H).symm.toAlgEquiv.toAlgHom
  map_star T := by
    change vacuumExpectation ((tensorOperatorEquiv H).symm (star T)) = _
    exact (congrArg vacuumExpectation ((tensorOperatorEquiv H).symm.map_star' T)).trans
      (vacuumExpectation_star _)
  positive T := by
    change 0 ≤ vacuumExpectation ((tensorOperatorEquiv H).symm (star T * T))
    rw [map_mul, map_star]
    exact (vacuumState (fullFockBasisSet H)).positive _

/-- This is the actual vacuum inner product on the completed-tensor domain. -/
theorem tensorVacuumState_expectation (T : TensorFullFock H →L[ℂ] TensorFullFock H) :
    (tensorVacuumState H).expectation T = inner ℂ (tensorVacuum H) (T (tensorVacuum H)) := by
  change inner ℂ (fullVacuum H) ((tensorOperatorEquiv H).symm T (fullVacuum H)) = _
  have he : tensorVacuum H = fullFockTensorDecomposition H (fullVacuum H) :=
    (fullFockTensorDecomposition_vacuum H).symm
  rw [he]
  change inner ℂ (fullVacuum H)
    ((fullFockTensorDecomposition H).symm (T (fullFockTensorDecomposition H (fullVacuum H)))) = _
  rw [← (fullFockTensorDecomposition H).inner_map_map]
  simp

/-- The actual field operator for a selected orthonormal one-particle vector. -/
def tensorSemicircular (i : fullFockBasisSet H) : TensorFullFock H →L[ℂ] TensorFullFock H :=
  tensorCreation H (fullFockBasis H i) + tensorAnnihilation H (fullFockBasis H i)

/-- The selected fields are exactly the unitary images of the established canonical system. -/
theorem tensorSemicircular_eq_transport (i : fullFockBasisSet H) :
    tensorSemicircular H i = tensorOperatorEquiv H (semicircular i) := by
  rw [tensorSemicircular, tensorAnnihilation_eq_transport, tensorCreation, ← map_add]
  congr 1
  change basisCreation (fullFockBasis H) (fullFockBasis H i) +
    (basisCreation (fullFockBasis H) (fullFockBasis H i)).adjoint = _
  rw [basisCreation_basis]
  rfl

/-- Unitary operator transport preserves the genuine operator norm. -/
theorem norm_tensorOperatorEquiv (T : FullFock H →L[ℂ] FullFock H) :
    ‖tensorOperatorEquiv H T‖ = ‖T‖ := by
  apply le_antisymm
  · apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg T)
    intro f
    change ‖fullFockTensorDecomposition H (T ((fullFockTensorDecomposition H).symm f))‖ ≤ _
    rw [LinearIsometryEquiv.norm_map, ← (fullFockTensorDecomposition H).symm.norm_map f]
    exact T.le_opNorm _
  · apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
    intro f
    have he := (tensorOperatorEquiv H T).le_opNorm (fullFockTensorDecomposition H f)
    change ‖fullFockTensorDecomposition H (T ((fullFockTensorDecomposition H).symm
      (fullFockTensorDecomposition H f)))‖ ≤ _ at he
    simpa only [LinearIsometryEquiv.symm_apply_apply, LinearIsometryEquiv.norm_map] using he

@[simp] theorem norm_tensorSemicircular (i : fullFockBasisSet H) : ‖tensorSemicircular H i‖ = 2 := by
  rw [tensorSemicircular_eq_transport, norm_tensorOperatorEquiv, norm_semicircular]

/-- Every selected field is an actual bounded self-adjoint operator. -/
theorem isSelfAdjoint_tensorSemicircular (i : fullFockBasisSet H) : IsSelfAdjoint (tensorSemicircular H i) := by
  rw [tensorSemicircular_eq_transport]
  change star (tensorOperatorEquiv H (semicircular i)) = tensorOperatorEquiv H (semicircular i)
  rw [← map_star, (isSelfAdjoint_semicircular i).star_eq]

/-- The unitary pullback of the actual closed singleton-generated operator algebra. -/
def tensorGeneratorAlgebra (i : fullFockBasisSet H) :
    Subalgebra ℂ (TensorFullFock H →L[ℂ] TensorFullFock H) :=
  (Algebra.adjoin ℂ ({semicircular i} : Set _)).topologicalClosure.comap
    (tensorOperatorEquiv H).symm.toAlgEquiv.toAlgHom

/-- The transported algebra is precisely the literal closed algebra generated by the field. -/
theorem tensorGeneratorAlgebra_eq_closed_adjoin (i : fullFockBasisSet H) :
    tensorGeneratorAlgebra H i =
      (Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _)).topologicalClosure := by
  let e := (tensorOperatorEquiv H).symm.toAlgEquiv.toAlgHom
  have hp : (Algebra.adjoin ℂ ({semicircular i} : Set _)).comap e =
      Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _) := by
    apply Subalgebra.map_injective (f := e) (tensorOperatorEquiv H).symm.injective
    rw [Subalgebra.map_comap_eq_self_of_surjective (tensorOperatorEquiv H).symm.surjective,
      AlgHom.map_adjoin_singleton]
    have he : e (tensorSemicircular H i) = semicircular i := by
      change (tensorOperatorEquiv H).symm (tensorSemicircular H i) = _
      rw [tensorSemicircular_eq_transport, StarAlgEquiv.symm_apply_apply]
    rw [he]
  change (Algebra.adjoin ℂ ({semicircular i} : Set _)).topologicalClosure.comap e = _
  rw [Subalgebra.topologicalClosure_comap_homeomorph _ e
    (fullFockTensorDecomposition H).symm.toContinuousLinearEquiv.conjContinuousAlgEquiv.toHomeomorph
    (by rfl), hp]

/-- Actual selected field belongs to its closed one-generator algebra. -/
theorem tensorSemicircular_mem_generatorAlgebra (i : fullFockBasisSet H) :
    tensorSemicircular H i ∈ tensorGeneratorAlgebra H i := by
  change (tensorOperatorEquiv H).symm (tensorSemicircular H i) ∈
    (Algebra.adjoin ℂ ({semicircular i} : Set (FullFock H →L[ℂ] FullFock H))).topologicalClosure
  rw [tensorSemicircular_eq_transport, StarAlgEquiv.symm_apply_apply]
  exact (Algebra.adjoin ℂ ({semicircular i} : Set _)).le_topologicalClosure
    (Algebra.self_mem_adjoin_singleton ℂ (semicircular i))

/-- Arbitrary centered elements of the selected closed singleton algebras are freely independent. -/
theorem freelyIndependent_tensorSemicircular :
    FreelyIndependent (tensorVacuumState H).toProbabilitySpace (tensorGeneratorAlgebra H) :=
  (freelyIndependent_semicircular_closed (fullFockBasisSet H)).comap
    (tensorOperatorEquiv H).symm.toAlgEquiv.toAlgHom (tensorGeneratorAlgebra H) (fun _ _ hx => hx)
/-- Freeness is also stated using the literal norm-closed singleton-generated algebras. -/
theorem freelyIndependent_tensorSemicircular_closed :
    FreelyIndependent (tensorVacuumState H).toProbabilitySpace
      (fun i => (Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _)).topologicalClosure) := by
  have he : tensorGeneratorAlgebra H =
      (fun i => (Algebra.adjoin ℂ ({tensorSemicircular H i} : Set _)).topologicalClosure) := by
    funext i
    exact tensorGeneratorAlgebra_eq_closed_adjoin H i
  rw [← he]
  exact freelyIndependent_tensorSemicircular H

end FreeProbability.Fock
