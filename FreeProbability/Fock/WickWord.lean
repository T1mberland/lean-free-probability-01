import FreeProbability.Fock.VacuumState
import Mathlib.Algebra.Star.Subalgebra

/-!
# Polynomial Wick words and vacuum cyclicity

The recursively defined Wick operators are polynomials in the concrete bounded
semicircular operators and send the vacuum to the canonical word vectors. This
is the elementary cyclicity prerequisite for generated-algebra faithfulness.
It does not yet give the joint noncrossing Wick moment formula.
-/

noncomputable section
open scoped Classical InnerProductSpace ENNReal

namespace FreeProbability.Fock

variable {I : Type*}

/-- Recursive Wick polynomial operator, with its first contraction subtracted. -/
def wick : List I → (WordSpace I →L[ℂ] WordSpace I)
  | [] => 1
  | i :: w => semicircular i * wick w -
      match w with
      | [] => 0
      | j :: v => if i = j then wick v else 0

@[simp] theorem wick_nil : wick ([] : List I) = 1 := rfl

@[simp] theorem wick_singleton (i : I) : wick [i] = semicircular i := by
  simp [wick]

/-- The algebraic star algebra generated by the canonical semicircular operators.
Its norm closure is a further construction, distinct from this polynomial algebra. -/
def semicircularAlgebra (I : Type*) : StarSubalgebra ℂ (WordSpace I →L[ℂ] WordSpace I) :=
  StarAlgebra.adjoin ℂ (Set.range semicircular)

theorem semicircular_mem_algebra (i : I) : semicircular i ∈ semicircularAlgebra I :=
  StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩

/-- Every Wick operator belongs to the generated semicircular star algebra. -/
theorem wick_mem_algebra (w : List I) : wick w ∈ semicircularAlgebra I := by
  induction w using List.twoStepInduction with
  | nil => exact (semicircularAlgebra I).one_mem
  | singleton i => simpa using semicircular_mem_algebra i
  | cons_cons i j w h₁ h₂ =>
    change semicircular i * wick (j :: w) - (if i = j then wick w else 0) ∈ _
    apply (semicircularAlgebra I).sub_mem
      ((semicircularAlgebra I).mul_mem (semicircular_mem_algebra i) (h₂ j))
    split
    · exact h₁
    · exact (semicircularAlgebra I).zero_mem

/-- Wick polynomials recover every word vector from the vacuum. -/
@[simp] theorem wick_vacuum (w : List I) : wick w (vacuum : WordSpace I) = word w := by
  induction w using List.twoStepInduction with
  | nil => simp [vacuum]
  | singleton i => simp
  | cons_cons i j w h₁ h₂ =>
    simp only [wick, sub_apply, mul_apply_eq_comp, h₂]
    change semicircular i (word (j :: w)) -
      (if i = j then wick w else 0) vacuum = word (i :: j :: w)
    simp only [semicircular, add_apply, creation_word, annihilation_word]
    by_cases h : i = j <;> simp [h, h₁]

/-- Wick vectors are orthonormal with respect to the actual vacuum state. -/
theorem vacuumExpectation_wick_star_mul (u v : List I) :
    vacuumExpectation (star (wick u) * wick v) = if u = v then 1 else 0 := by
  simp only [vacuumExpectation, mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
    ContinuousLinearMap.adjoint_inner_right, wick_vacuum, inner_word]

/-- A bounded operator annihilating all word vectors is zero. -/
theorem eq_zero_of_word (T : WordSpace I →L[ℂ] WordSpace I)
    (h : ∀ w, T (word w) = 0) : T = 0 := by
  apply lp.ext_continuousLinearMap (by norm_num : (2 : ℝ≥0∞) ≠ ⊤)
  intro w
  apply ContinuousLinearMap.ext
  intro z
  have hz : lp.single (E := fun _ : List I => ℂ) 2 w z = z • word w := by
    simp [word, ← lp.single_smul]
  simp [hz, h]

/-- Commutation with each generator implies commutation with each Wick polynomial. -/
theorem commute_wick (T : WordSpace I →L[ℂ] WordSpace I)
    (h : ∀ i, Commute T (semicircular i)) (w : List I) : Commute T (wick w) := by
  induction w using List.twoStepInduction with
  | nil => simp
  | singleton i => simpa using h i
  | cons_cons i j w h₁ h₂ =>
    change Commute T (semicircular i * wick (j :: w) - if i = j then wick w else 0)
    apply ((h i).mul_right (h₂ j)).sub_right
    split <;> simp_all

/-- The vacuum is separating for the commutant of the semicircular generators.
This uses actual cyclicity, rather than assuming faithfulness of a state. -/
theorem eq_zero_of_commute_semicircular_of_vacuum_eq_zero
    (T : WordSpace I →L[ℂ] WordSpace I)
    (hcomm : ∀ i, Commute T (semicircular i))
    (hΩ : T (vacuum : WordSpace I) = 0) : T = 0 := by
  apply eq_zero_of_word T
  intro w
  rw [← wick_vacuum]
  have hw := congrArg (fun U : WordSpace I →L[ℂ] WordSpace I => U vacuum)
    (commute_wick T hcomm w).eq
  simpa [mul_apply_eq_comp, hΩ] using hw

end FreeProbability.Fock
