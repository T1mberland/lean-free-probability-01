import FreeProbability.OperatorValued.MatrixStatePositivity
import Mathlib.Analysis.CStarAlgebra.CompletelyPositiveMap
import Mathlib.Analysis.Matrix.Order

/-!
# Positive scalar states are genuinely completely positive

The input is an arbitrary positive C-star matrix. The canonical positive cone
is generated by actual star squares; proved Gram positivity and linearity give
the output cone at every finite level. Complete positivity is concluded.
-/

namespace FreeProbability.StarProbabilitySpace

open Matrix
open scoped ComplexOrder CStarAlgebra MatrixOrder

variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- The actual positive normalized scalar state as a bundled completely positive
map, with its full finite-matrix positivity proved. -/
def toCompletelyPositiveMap (φ : StarProbabilitySpace A) : A →CP ℂ where
  toLinearMap := φ.expectation
  map_cstarMatrix_nonneg' := by
    intro k X hX
    have hx := StarOrderedRing.nonneg_iff.mp hX
    refine AddSubmonoid.closure_induction
      (motive := fun M _ => 0 ≤ M.map φ.expectation) ?_ ?_ ?_ hx
    · intro M hM
      obtain ⟨Y, rfl⟩ := hM
      let Z : Matrix (Fin k) (Fin k) ℂ :=
        CStarMatrix.ofMatrix.symm ((star Y * Y).map φ.expectation)
      have hZ : Z.PosSemidef := by
        change (matrixExpectation φ.toProbabilitySpace
          ((CStarMatrix.ofMatrix.symm Y)ᴴ * CStarMatrix.ofMatrix.symm Y)).PosSemidef
        exact matrixExpectation_gram_posSemidef φ _
      have hp : 0 ≤ Z := hZ.nonneg
      have hc : 0 ≤ CStarMatrix.ofMatrix Z :=
        map_nonneg (CStarMatrix.ofMatrixStarAlgEquiv :
          Matrix (Fin k) (Fin k) ℂ ≃⋆ₐ[ℂ] CStarMatrix (Fin k) (Fin k) ℂ) hp
      exact hc
    · have he : (0 : CStarMatrix (Fin k) (Fin k) A).map φ.expectation = 0 := by
        ext i j
        exact map_zero φ.expectation
      rw [he]
    · intro M N _ _ hM hN
      have he : (M + N).map φ.expectation = M.map φ.expectation + N.map φ.expectation := by
        ext i j
        exact map_add φ.expectation _ _
      rw [he]
      exact add_nonneg hM hN

@[simp] theorem toCompletelyPositiveMap_apply (φ : StarProbabilitySpace A) (a : A) :
    φ.toCompletelyPositiveMap a = φ.expectation a := rfl

end FreeProbability.StarProbabilitySpace
